# ─────────────────────────────────────────────
# RiskShield AI — Environment Variables Template
# Copy this file to .env and fill in real values
# NEVER commit .env to version control
# ─────────────────────────────────────────────

# JWT Secret — generate with: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-here

# Database
POSTGRES_DB=riskshield
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password-here
DATABASE_URL=postgresql://postgres:your-postgres-password-here@postgres:5432/riskshield

# ML Model Paths (leave as-is for Docker, override for local dev)
MODEL_PATH=/app/ml/models/model.pkl
METRICS_PATH=/app/ml/models/metrics.json
